# Скопіюйте цей файл у .env та за потреби змініть значення.

# Середовище: development | production
FLASK_ENV=development

# Секрети (ОБОВ'ЯЗКОВО змініть у production!)
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-in-production

# Шлях до бази даних (за замовчуванням instance/profihub.db)
# DATABASE_URL=sqlite:///profihub.db

# Additive-автоміграція схеми при старті (1 = увімкнено). Дописує нові
# nullable-колонки до існуючих таблиць, щоб не перестворювати базу вручну.
AUTO_MIGRATE=1

# Початковий пароль супер-адміна, що створюється seed-скриптом
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# --- LLM-провайдери ---
# Глобальний перемикач моку. 1 = усі провайдери у режимі моку (без ключів).
# Поставте 0, щоб використовувати реальні API (потрібні відповідні ключі + SDK).
LLM_MOCK=1

# Azure OpenAI / Azure AI Foundry (New Foundry, v1 API — OpenAI-сумісний).
# Endpoint — корінь ресурсу; "/openai/v1" додається автоматично (можна лишити
# або прибрати шлях — обидва варіанти працюють).
#   https://<resource>.openai.azure.com   або   .../openai/v1
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# API_VERSION для чату НЕ потрібна (v1). Значення нижче використовується лише
# для отримання списку деплойментів; НЕ плутайте з версією МОДЕЛІ (напр.
# gpt-4o version:2025-11-13 — це версія моделі, а не API).
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview

# Локальні / OpenAI-сумісні моделі (Ollama, LM Studio — локально чи віддалено).
# Базовий URL задається на кожній моделі у вкладці «Моделі»; ці — дефолти/фолбек.
LOCAL_BASE_URL=http://localhost:11434/v1
# Локальні сервери зазвичай не потребують ключа (openai SDK вимагає непорожній).
LOCAL_API_KEY=local
# Таймаут очікування відповіді моделі (сек). За замовчуванням 1800 (30 хв) —
# локальні моделі можуть відповідати довго; користувач може перервати «Стоп».
LLM_TIMEOUT=1800

# Веб-пошук (онлайн-режим чату, DuckDuckGo через пакет ddgs; без ключа).
# WEB_SEARCH_MOCK=1 → демо-результати без мережі (за замовчуванням = LLM_MOCK).
WEB_SEARCH_MOCK=1
WEB_SEARCH_MAX_RESULTS=5

# --- Скіли-пакети (виконання коду) ---
# Чи дозволено реально виконувати Python-код зі скілів-пакетів (1 = так).
SKILL_EXEC_ENABLED=1
# Таймаут одного виконання (секунди).
SKILL_EXEC_TIMEOUT=120
# Макс. кроків (ітерацій модель↔код) для агентного (стандартного) скіла.
SKILL_AGENT_MAX_STEPS=6
# Авто-іменування чатів системною моделлю (асинхронно після першого обміну).
CHAT_AUTONAME=1
# Ліміт пам'яті процесу у МБ (0 = вимкнути; на деяких системах RLIMIT_AS
# заважає запуску Python — тоді лишайте 0).
SKILL_EXEC_MEMORY_MB=0
# Каталог зберігання архівів скілів (за замовчуванням instance/skill_packages).
# SKILL_PACKAGES_DIR=
# Тимчасова тека виконання скілів — усередині застосунку (не /tmp).
# SKILL_RUN_DIR=

# --- Квоти токенів (тижневі) ---
# Системна тижнева квота за замовчуванням (Admin може змінити в UI).
DEFAULT_WEEKLY_TOKEN_LIMIT=2000
# Планувальник тижневого скидання лічильників (понеділок 00:05 UTC).
ENABLE_SCHEDULER=1

# --- Файли користувачів ---
# Каталог файлів користувачів (підкаталог-GUID на кожного користувача).
# USER_FILES_DIR=
# Максимальний розмір одного файлу (байти; за замовчуванням 25 МБ).
# USER_FILE_MAX_BYTES=26214400
